<project xmlns="http://www.plcopen.org/xml/tc6_0201" xmlns:bms="urn:bms-studio:program:1" xmlns:xhtml="http://www.w3.org/1999/xhtml"><fileHeader companyName="BMS Studio" productName="BMS Studio" productVersion="0.1.0" creationDateTime="2026-10-18T00:00:00Z" /><contentHeader name="Synthetic legacy numeric archive"><coordinateInfo><fbd><scaling x="1" y="1" /></fbd><ld><scaling x="1" y="1" /></ld><sfc><scaling x="1" y="1" /></sfc></coordinateInfo></contentHeader><types><dataTypes /><pous><pou name="MAIN" pouType="program"><interface><inputVars><variable name="StudioScanSeconds"><type><REAL /></type><initialValue><simpleValue value="1.0" /></initialValue></variable><variable name="StudioDayOfWeek"><type><INT /></type><initialValue><simpleValue value="0" /></initialValue></variable><variable name="StudioMinuteOfDay"><type><INT /></type><initialValue><simpleValue value="0" /></initialValue></variable></inputVars><outputVars><variable name="StudioFault"><type><BOOL /></type><initialValue><simpleValue value="FALSE" /></initialValue></variable><variable name="n_out"><type><REAL /></type></variable></outputVars><localVars><variable name="n_source"><type><REAL /></type></variable><variable name="n_out_stage"><type><REAL /></type></variable></localVars></interface><body><ST><xhtml:p>(* BMS Studio scan. Inputs and clock are supplied by the target runtime. *)
StudioFault := FALSE;
IF (StudioScanSeconds &lt;= 0.0) OR (StudioScanSeconds &gt; 60.0) THEN StudioFault := TRUE; RETURN; END_IF;
n_source := 9.00719925474099E+15;
IF (n_source &lt;&gt; n_source) OR (ABS(n_source) &gt; 3.0E+38) THEN StudioFault := TRUE; RETURN; END_IF;
n_out_stage := n_source;
IF (n_out_stage &lt;&gt; n_out_stage) OR (ABS(n_out_stage) &gt; 3.0E+38) THEN StudioFault := TRUE; RETURN; END_IF;
(* Commit state and outputs only after every block succeeds. *)
n_out := n_out_stage;</xhtml:p></ST></body></pou></pous></types><instances><configurations /></instances><addData><data name="urn:bms-studio:program:1" handleUnknown="implementation"><bms:program sha256="f6f307aa4fba3cf8d3dfb1691b0841ebaa20f2497cfa3610e2ae5211c49d98a4"></bms:program></data></addData></project>