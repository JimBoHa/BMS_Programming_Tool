<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://www.plcopen.org/xml/tc6_0201" xmlns:bms="urn:bms-studio:program:1" xmlns:xhtml="http://www.w3.org/1999/xhtml"><fileHeader companyName="BMS Studio" productName="BMS Studio" productVersion="0.1.0" creationDateTime="2026-10-18T00:00:00Z" /><contentHeader name="state-calendar"><coordinateInfo><fbd><scaling x="1" y="1" /></fbd><ld><scaling x="1" y="1" /></ld><sfc><scaling x="1" y="1" /></sfc></coordinateInfo></contentHeader><types><dataTypes /><pous><pou name="MAIN" pouType="program"><interface><inputVars><variable name="StudioScanSeconds"><type><REAL /></type><initialValue><simpleValue value="1.0" /></initialValue></variable><variable name="StudioDayOfWeek"><type><INT /></type><initialValue><simpleValue value="0" /></initialValue></variable><variable name="StudioMinuteOfDay"><type><INT /></type><initialValue><simpleValue value="0" /></initialValue></variable><variable name="n_value"><type><REAL /></type><initialValue><simpleValue value="2.0" /></initialValue></variable><variable name="n_value_valid"><type><BOOL /></type><initialValue><simpleValue value="TRUE" /></initialValue></variable><variable name="n_request"><type><BOOL /></type><initialValue><simpleValue value="TRUE" /></initialValue></variable><variable name="n_request_valid"><type><BOOL /></type><initialValue><simpleValue value="TRUE" /></initialValue></variable><variable name="n_calendar_calendar"><type><BOOL /></type><initialValue><simpleValue value="FALSE" /></initialValue></variable><variable name="n_calendar_calendar_valid"><type><BOOL /></type><initialValue><simpleValue value="FALSE" /></initialValue></variable></inputVars><outputVars><variable name="StudioFault"><type><BOOL /></type><initialValue><simpleValue value="FALSE" /></initialValue></variable><variable name="n_controller_out"><type><REAL /></type></variable><variable name="n_memory_out"><type><REAL /></type></variable><variable name="n_hysteresis_out"><type><BOOL /></type></variable><variable name="n_timer_out"><type><BOOL /></type></variable><variable name="n_alarm_out"><type><BOOL /></type></variable><variable name="n_ramp_out"><type><REAL /></type></variable><variable name="n_calendar_out"><type><BOOL /></type></variable></outputVars><localVars><variable name="n_setpoint"><type><REAL /></type></variable><variable name="n_middle"><type><REAL /></type></variable><variable name="n_controller"><type><REAL /></type></variable><variable name="n_memory"><type><REAL /></type></variable><variable name="n_hysteresis"><type><BOOL /></type></variable><variable name="n_timer"><type><BOOL /></type></variable><variable name="n_alarm"><type><BOOL /></type></variable><variable name="n_ramp"><type><REAL /></type></variable><variable name="n_calendar"><type><BOOL /></type></variable><variable name="n_controller_out_stage"><type><REAL /></type></variable><variable name="n_memory_out_stage"><type><REAL /></type></variable><variable name="n_hysteresis_out_stage"><type><BOOL /></type></variable><variable name="n_timer_out_stage"><type><BOOL /></type></variable><variable name="n_alarm_out_stage"><type><BOOL /></type></variable><variable name="n_ramp_out_stage"><type><REAL /></type></variable><variable name="n_calendar_out_stage"><type><BOOL /></type></variable><variable name="n_memory_memory"><type><REAL /></type><initialValue><simpleValue value="7.25" /></initialValue></variable><variable name="n_alarm_elapsed"><type><REAL /></type><initialValue><simpleValue value="0.0" /></initialValue></variable><variable name="n_alarm_next"><type><REAL /></type><initialValue><simpleValue value="0.0" /></initialValue></variable><variable name="n_controller_integral"><type><REAL /></type><initialValue><simpleValue value="0.0" /></initialValue></variable><variable name="n_controller_candidate"><type><REAL /></type><initialValue><simpleValue value="0.0" /></initialValue></variable><variable name="n_controller_error"><type><REAL /></type><initialValue><simpleValue value="0.0" /></initialValue></variable><variable name="n_controller_raw"><type><REAL /></type><initialValue><simpleValue value="0.0" /></initialValue></variable><variable name="n_hysteresis_memory"><type><BOOL /></type><initialValue><simpleValue value="TRUE" /></initialValue></variable><variable name="n_ramp_memory"><type><REAL /></type><initialValue><simpleValue value="3.0" /></initialValue></variable><variable name="n_timer_elapsed"><type><REAL /></type><initialValue><simpleValue value="0.0" /></initialValue></variable><variable name="n_timer_next"><type><REAL /></type><initialValue><simpleValue value="0.0" /></initialValue></variable></localVars></interface><body><ST><xhtml:p>(* BMS Studio scan. Inputs and clock are supplied by the target runtime. *)
StudioFault := FALSE;
IF (StudioScanSeconds &lt;= 0.0) OR (StudioScanSeconds &gt; 60.0) THEN StudioFault := TRUE; RETURN; END_IF;
IF NOT n_value_valid OR (n_value &lt;&gt; n_value) OR (ABS(n_value) &gt; 3.0E+38) THEN StudioFault := TRUE; RETURN; END_IF;
IF NOT n_request_valid THEN StudioFault := TRUE; RETURN; END_IF;
IF NOT n_calendar_calendar_valid THEN StudioFault := TRUE; RETURN; END_IF;
(* Host evaluates the project's IANA timezone and dated exceptions; mark valid only for the current scan. *)
n_calendar := n_calendar_calendar;
n_memory := n_memory_memory;
IF (n_memory &lt;&gt; n_memory) OR (ABS(n_memory) &gt; 3.0E+38) THEN StudioFault := TRUE; RETURN; END_IF;
n_middle := 0.5;
IF (n_middle &lt;&gt; n_middle) OR (ABS(n_middle) &gt; 3.0E+38) THEN StudioFault := TRUE; RETURN; END_IF;
n_setpoint := 5.0;
IF (n_setpoint &lt;&gt; n_setpoint) OR (ABS(n_setpoint) &gt; 3.0E+38) THEN StudioFault := TRUE; RETURN; END_IF;
IF n_value &gt; 4.0 THEN n_alarm_next := n_alarm_elapsed + StudioScanSeconds; ELSE n_alarm_next := 0.0; END_IF;
n_alarm := (n_value &gt; 4.0) AND (n_alarm_next &gt;= 2.0);
n_calendar_out_stage := n_calendar;
n_controller_error := (n_setpoint - n_value) * 1.0;
n_controller_candidate := n_controller_integral + 0.5 * n_controller_error * StudioScanSeconds;
n_controller_raw := 2.0 * n_controller_error + n_controller_candidate;
IF ((n_controller_raw &gt;= -100.0) AND (n_controller_raw &lt;= 100.0)) OR ((n_controller_raw &gt; 100.0) AND (n_controller_error * 0.5 &lt; 0.0)) OR ((n_controller_raw &lt; -100.0) AND (n_controller_error * 0.5 &gt; 0.0)) THEN
  n_controller := MAX(-100.0, MIN(100.0, 2.0 * n_controller_error + n_controller_candidate));
ELSE
  n_controller_candidate := n_controller_integral;
  n_controller := MAX(-100.0, MIN(100.0, 2.0 * n_controller_error + n_controller_integral));
END_IF;
IF (n_controller &lt;&gt; n_controller) OR (ABS(n_controller) &gt; 3.0E+38) THEN StudioFault := TRUE; RETURN; END_IF;
n_hysteresis := n_hysteresis_memory;
IF n_middle &gt;= 1.0 THEN n_hysteresis := TRUE; ELSIF n_middle &lt;= 0.0 THEN n_hysteresis := FALSE; END_IF;
n_memory_out_stage := n_memory;
IF (n_memory_out_stage &lt;&gt; n_memory_out_stage) OR (ABS(n_memory_out_stage) &gt; 3.0E+38) THEN StudioFault := TRUE; RETURN; END_IF;
n_ramp := n_ramp_memory + MAX(-(1.0 * StudioScanSeconds), MIN(1.0 * StudioScanSeconds, n_setpoint - n_ramp_memory));
IF (n_ramp &lt;&gt; n_ramp) OR (ABS(n_ramp) &gt; 3.0E+38) THEN StudioFault := TRUE; RETURN; END_IF;
IF n_request THEN n_timer_next := n_timer_elapsed + StudioScanSeconds; ELSE n_timer_next := 0.0; END_IF;
n_timer := (n_request) AND (n_timer_next &gt;= 2.0);
n_alarm_out_stage := n_alarm;
n_controller_out_stage := n_controller;
IF (n_controller_out_stage &lt;&gt; n_controller_out_stage) OR (ABS(n_controller_out_stage) &gt; 3.0E+38) THEN StudioFault := TRUE; RETURN; END_IF;
n_hysteresis_out_stage := n_hysteresis;
n_ramp_out_stage := n_ramp;
IF (n_ramp_out_stage &lt;&gt; n_ramp_out_stage) OR (ABS(n_ramp_out_stage) &gt; 3.0E+38) THEN StudioFault := TRUE; RETURN; END_IF;
n_timer_out_stage := n_timer;
(* Commit state and outputs only after every block succeeds. *)
n_memory_memory := n_value;
n_alarm_elapsed := n_alarm_next;
n_controller_integral := n_controller_candidate;
n_hysteresis_memory := n_hysteresis;
n_ramp_memory := n_ramp;
n_timer_elapsed := n_timer_next;
n_calendar_out := n_calendar_out_stage;
n_memory_out := n_memory_out_stage;
n_alarm_out := n_alarm_out_stage;
n_controller_out := n_controller_out_stage;
n_hysteresis_out := n_hysteresis_out_stage;
n_ramp_out := n_ramp_out_stage;
n_timer_out := n_timer_out_stage;</xhtml:p></ST></body></pou></pous></types><instances><configurations /></instances><addData><data name="urn:bms-studio:program:1" handleUnknown="implementation"><bms:program sha256="1282774c9eb4613626944198106f6a9fc276fda655e2f448878295ff33c47b11" sourceProfile="studio-literals/2" sourceProfileRules="be014ca51c1d3e42538d607d698b8ddacd164b2e0ddfb821c433329b99050493"></bms:program></data></addData></project>