<project xmlns="http://www.plcopen.org/xml/tc6_0201" xmlns:bms="urn:bms-studio:program:1" xmlns:xhtml="http://www.w3.org/1999/xhtml"><fileHeader companyName="BMS Studio" productName="BMS Studio" productVersion="0.1.0" creationDateTime="2026-10-18T00:00:00Z" /><contentHeader name="numbers"><coordinateInfo><fbd><scaling x="1" y="1" /></fbd><ld><scaling x="1" y="1" /></ld><sfc><scaling x="1" y="1" /></sfc></coordinateInfo></contentHeader><types><dataTypes /><pous><pou name="MAIN" pouType="program"><interface><inputVars><variable name="StudioScanSeconds"><type><REAL /></type><initialValue><simpleValue value="1.0" /></initialValue></variable><variable name="StudioDayOfWeek"><type><INT /></type><initialValue><simpleValue value="0" /></initialValue></variable><variable name="StudioMinuteOfDay"><type><INT /></type><initialValue><simpleValue value="0" /></initialValue></variable><variable name="n_source"><type><REAL /></type><initialValue><simpleValue value="1.00000005960464" /></initialValue></variable><variable name="n_source_valid"><type><BOOL /></type><initialValue><simpleValue value="TRUE" /></initialValue></variable></inputVars><outputVars><variable name="StudioFault"><type><BOOL /></type><initialValue><simpleValue value="FALSE" /></initialValue></variable><variable name="n_output_value"><type><REAL /></type></variable><variable name="n_output_zero"><type><REAL /></type></variable><variable name="n_output_large"><type><REAL /></type></variable></outputVars><localVars><variable name="n_negative_zero"><type><REAL /></type></variable><variable name="n_large_even_integer"><type><REAL /></type></variable><variable name="n_output_value_stage"><type><REAL /></type></variable><variable name="n_output_zero_stage"><type><REAL /></type></variable><variable name="n_output_large_stage"><type><REAL /></type></variable></localVars></interface><body><ST><xhtml:p>(* BMS Studio scan. Inputs and clock are supplied by the target runtime. *)
StudioFault := FALSE;
IF (StudioScanSeconds &lt;= 0.0) OR (StudioScanSeconds &gt; 60.0) THEN StudioFault := TRUE; RETURN; END_IF;
IF NOT n_source_valid OR (n_source &lt;&gt; n_source) OR (ABS(n_source) &gt; 3.0E+38) THEN StudioFault := TRUE; RETURN; END_IF;
n_large_even_integer := 1.15292150460685E+18;
IF (n_large_even_integer &lt;&gt; n_large_even_integer) OR (ABS(n_large_even_integer) &gt; 3.0E+38) THEN StudioFault := TRUE; RETURN; END_IF;
n_negative_zero := -0.0;
IF (n_negative_zero &lt;&gt; n_negative_zero) OR (ABS(n_negative_zero) &gt; 3.0E+38) THEN StudioFault := TRUE; RETURN; END_IF;
n_output_large_stage := n_large_even_integer;
IF (n_output_large_stage &lt;&gt; n_output_large_stage) OR (ABS(n_output_large_stage) &gt; 3.0E+38) THEN StudioFault := TRUE; RETURN; END_IF;
n_output_value_stage := n_source;
IF (n_output_value_stage &lt;&gt; n_output_value_stage) OR (ABS(n_output_value_stage) &gt; 3.0E+38) THEN StudioFault := TRUE; RETURN; END_IF;
n_output_zero_stage := n_negative_zero;
IF (n_output_zero_stage &lt;&gt; n_output_zero_stage) OR (ABS(n_output_zero_stage) &gt; 3.0E+38) THEN StudioFault := TRUE; RETURN; END_IF;
(* Commit state and outputs only after every block succeeds. *)
n_output_large := n_output_large_stage;
n_output_value := n_output_value_stage;
n_output_zero := n_output_zero_stage;</xhtml:p></ST></body></pou></pous></types><instances><configurations /></instances><addData><data name="urn:bms-studio:program:1" handleUnknown="implementation"><bms:program sha256="f3e2538f20cd41acf4c35ae4df8b15ed11d8303f47c1a8516f2078d40a0b6112"></bms:program></data></addData></project>